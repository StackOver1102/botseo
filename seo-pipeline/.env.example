# Copy thành .env rồi điền. File .env không được commit.

# Bắt buộc: Claude (writer, P1, P2a, P3…)
ANTHROPIC_API_KEY=

# Chỉ cần khi đổi providers.<hãng>.mode sang "api" trong config/config.yaml
OPENAI_API_KEY=
GEMINI_API_KEY=

# SERP tự động (serper.dev). Bỏ trống thì phải có serp.csv trong thư mục job
SERPER_API_KEY=

# Token cho extension (header X-Extension-Token) và cho API /jobs (X-Admin-Token)
SEO_EXTENSION_TOKEN=devtoken
SEO_ADMIN_TOKEN=

# Mặc định: postgresql://seo:seo@localhost:55432/seo
# SEO_DATABASE_URL=
