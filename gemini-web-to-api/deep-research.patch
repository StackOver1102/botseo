@@ -0,0 +1,671 @@
+package providers
+
+// Native Deep Research: drives Gemini Web's own Deep Research tool instead of
+// emulating it with ordinary chat turns.
+//
+// The flow is the one the web UI performs, ported from gemini_webapi
+// (HanaokaYuzu/Gemini-API, components/research_mixin.py):
+//
+//  1. Send the topic as a chat turn flagged for deep research. Gemini answers
+//     with a research plan (title, steps, ETA) and waits.
+//  2. Send the confirmation turn ("Start research") in the same conversation.
+//     This is the "Start research" button; the task now runs server-side.
+//  3. Re-read the conversation until a turn carries the finished report. The
+//     report is an attached document, not reply text, and its body stays empty
+//     while the research is running.
+
+import (
+	"context"
+	crand "crypto/rand"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"math/rand"
+	"net/http"
+	"net/url"
+	"os"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+	"go.uber.org/zap"
+)
+
+const (
+	// DeepResearchModeNative runs Gemini's own Deep Research tool.
+	DeepResearchModeNative = "native"
+	// DeepResearchModeEmulated runs the plan/search/synthesize chain of plain chat turns.
+	DeepResearchModeEmulated = "emulated"
+
+	deepResearchModeEnv         = "GEMINI_DEEP_RESEARCH_MODE"
+	deepResearchPollEnv         = "GEMINI_DEEP_RESEARCH_POLL_SECONDS"
+	deepResearchDebugDirEnv     = "GEMINI_DEEP_RESEARCH_DEBUG_DIR"
+	deepResearchDefaultPoll     = 20 * time.Second
+	deepResearchDefaultConfirm  = "Start research"
+	deepResearchTaskPlaceholder = "agency-placeholder-task-id"
+	listConversationTurnsRPC    = "hNvQHb"
+	maxChatReadResponseSize     = 32 << 20
+
+	// Field numbers inside a candidate's rich content block ([12]).
+	fieldCitations         = 43
+	fieldResearchPlan      = 55
+	fieldResearchPlanAlt   = 56
+	deepResearchTokenBytes = 1950 // ~2600 base64url characters, as the web client sends
+)
+
+// deepResearchMode returns the configured mode; native is the default.
+func deepResearchMode() string {
+	if strings.EqualFold(strings.TrimSpace(os.Getenv(deepResearchModeEnv)), DeepResearchModeEmulated) {
+		return DeepResearchModeEmulated
+	}
+	return DeepResearchModeNative
+}
+
+func deepResearchPollInterval() time.Duration {
+	if n, err := strconv.Atoi(strings.TrimSpace(os.Getenv(deepResearchPollEnv))); err == nil && n >= 5 {
+		return time.Duration(n) * time.Second
+	}
+	return deepResearchDefaultPoll
+}
+
+// dumpResearchBody writes a raw response body to GEMINI_DEEP_RESEARCH_DEBUG_DIR
+// when that is set. Google changes this protocol without notice; the dumps are
+// what the field positions in this file are checked against. They contain the
+// conversation (prompt, plan, report) but no cookies or tokens.
+func dumpResearchBody(kind, body string) {
+	dir := strings.TrimSpace(os.Getenv(deepResearchDebugDirEnv))
+	if dir == "" || body == "" {
+		return
+	}
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return
+	}
+	name := fmt.Sprintf("%s-%s.txt", time.Now().UTC().Format("20060102T150405.000"), kind)
+	_ = os.WriteFile(dir+string(os.PathSeparator)+name, []byte(body), 0o600)
+}
+
+// applyDeepResearchFlags marks a StreamGenerate request as a deep research turn.
+func applyDeepResearchFlags(inner []interface{}) {
+	token := make([]byte, deepResearchTokenBytes)
+	_, _ = crand.Read(token)
+	inner[3] = "!" + base64.RawURLEncoding.EncodeToString(token)
+	inner[4] = strings.ReplaceAll(uuid.NewString(), "-", "")
+	inner[45] = nil // research cannot run in a temporary chat: the report is read back from history
+	inner[49] = 1
+	inner[54] = []interface{}{[]interface{}{[]interface{}{[]interface{}{[]interface{}{1}}}}}
+	inner[55] = []interface{}{[]interface{}{1}}
+}
+
+// nativeResearchPlan is the plan Gemini proposes before it starts researching.
+type nativeResearchPlan struct {
+	Title         string
+	Steps         []string
+	ETA           string
+	ConfirmPrompt string
+}
+
+// nativeResearchDocument is the report a research turn attaches to its reply.
+type nativeResearchDocument struct {
+	ID      string
+	Title   string
+	Content string
+	Sources []SourceInfo
+}
+
+// researchTurn is what one model turn of a research conversation carries.
+type researchTurn struct {
+	Text     string
+	Plan     *nativeResearchPlan
+	Document *nativeResearchDocument
+	Status   int // candidate[8][0]: 1 = still running, 2 = finished
+}
+
+// researchConversation tracks the ids needed to continue and re-read a chat.
+// Metadata mirrors the 10-slot list Gemini expects at inner[2]:
+// [cid, rid, rcid, _, _, _, _, _, _, context].
+type researchConversation struct {
+	Metadata []interface{}
+}
+
+func newResearchConversation() *researchConversation {
+	return &researchConversation{Metadata: []interface{}{"", "", "", nil, nil, nil, nil, nil, nil, ""}}
+}
+
+func (r *researchConversation) cid() string {
+	s, _ := r.Metadata[0].(string)
+	return s
+}
+
+// merge keeps existing ids when a frame leaves a slot empty.
+func (r *researchConversation) merge(values []interface{}) {
+	for i, v := range values {
+		if i >= len(r.Metadata) || v == nil {
+			continue
+		}
+		if s, ok := v.(string); ok && s == "" {
+			continue
+		}
+		r.Metadata[i] = v
+	}
+}
+
+// ---------------------------------------------------------------------------
+// JSPB helpers
+// ---------------------------------------------------------------------------
+
+// nested walks a decoded JSON array by index and returns nil when the path ends early.
+func nested(data any, path ...int) any {
+	current := data
+	for _, index := range path {
+		list, ok := current.([]interface{})
+		if !ok || index < 0 || index >= len(list) {
+			return nil
+		}
+		current = list[index]
+	}
+	return current
+}
+
+func nestedString(data any, path ...int) string {
+	s, _ := nested(data, path...).(string)
+	return s
+}
+
+func isEmptyJSPB(v any) bool {
+	switch value := v.(type) {
+	case nil:
+		return true
+	case []interface{}:
+		return len(value) == 0
+	case map[string]interface{}:
+		return len(value) == 0
+	}
+	return false
+}
+
+// jspbField reads field index of a JSPB array from its positional slot or, for
+// sparse high-numbered fields, from the trailing object keyed by the one-based
+// field number (positional 55 appears as key "56").
+func jspbField(container any, index int) any {
+	list, ok := container.([]interface{})
+	if !ok || len(list) == 0 {
+		return nil
+	}
+	var value any
+	if index >= 0 && index < len(list) {
+		value = list[index]
+	}
+	if _, isBundle := value.(map[string]interface{}); isEmptyJSPB(value) || isBundle {
+		value = nil
+		if bundle, ok := list[len(list)-1].(map[string]interface{}); ok {
+			value = bundle[strconv.Itoa(index+1)]
+		}
+	}
+	if isEmptyJSPB(value) {
+		return nil
+	}
+	return value
+}
+
+// decodeFrames returns every payload (the JSON string at [2] of an envelope)
+// found in a StreamGenerate or batchexecute body, optionally filtered by RPC id.
+func decodeFrames(body, rpcID string) []any {
+	var payloads []any
+	for _, line := range strings.Split(body, "\n") {
+		line = strings.TrimPrefix(strings.TrimSpace(line), ")]}'")
+		if !strings.HasPrefix(line, "[") {
+			continue
+		}
+		var root []interface{}
+		if err := json.Unmarshal([]byte(line), &root); err != nil {
+			continue
+		}
+		for _, item := range root {
+			envelope, ok := item.([]interface{})
+			if !ok || len(envelope) < 3 {
+				continue
+			}
+			if rpcID != "" && nestedString(envelope, 1) != rpcID {
+				continue
+			}
+			raw, ok := envelope[2].(string)
+			if !ok || raw == "" {
+				continue
+			}
+			var payload any
+			if err := json.Unmarshal([]byte(raw), &payload); err != nil {
+				continue
+			}
+			payloads = append(payloads, payload)
+		}
+	}
+	return payloads
+}
+
+// ---------------------------------------------------------------------------
+// Plan, document and citation extraction
+// ---------------------------------------------------------------------------
+
+func extractResearchPlan(candidate any) *nativeResearchPlan {
+	rich := nested(candidate, 12)
+	payload, ok := jspbField(rich, fieldResearchPlan).([]interface{})
+	if !ok {
+		payload, ok = jspbField(rich, fieldResearchPlanAlt).([]interface{})
+	}
+	if !ok {
+		return nil
+	}
+	plan := &nativeResearchPlan{
+		Title:         nestedString(payload, 0),
+		ETA:           nestedString(payload, 2),
+		ConfirmPrompt: nestedString(payload, 3, 0),
+	}
+	if steps, ok := nested(payload, 1).([]interface{}); ok {
+		for _, step := range steps {
+			label, body := nestedString(step, 1), nestedString(step, 2)
+			switch {
+			case label != "" && body != "":
+				plan.Steps = append(plan.Steps, label+": "+body)
+			case body != "":
+				plan.Steps = append(plan.Steps, body)
+			case label != "":
+				plan.Steps = append(plan.Steps, label)
+			}
+		}
+	}
+	if plan.Title == "" && plan.ETA == "" && plan.ConfirmPrompt == "" && len(plan.Steps) == 0 {
+		return nil
+	}
+	return plan
+}
+
+func extractResearchDocument(candidate any) *nativeResearchDocument {
+	document, ok := nested(candidate, 30, 0).([]interface{})
+	if !ok {
+		return nil
+	}
+	// [30] is a generic attachment block (a YouTube card fills it too); only a
+	// research document carries a task id at [3].
+	if isEmptyJSPB(nested(document, 3)) {
+		return nil
+	}
+	content := nestedString(document, 4)
+	if content == "" {
+		content = nestedString(document, 17, 0)
+	}
+	sources := extractCitations(jspbField(nested(document, 17, 1), fieldCitations))
+	if len(sources) == 0 {
+		sources = extractCitations(jspbField(nested(document, 5), fieldCitations))
+	}
+	return &nativeResearchDocument{
+		ID:      nestedString(document, 0),
+		Title:   nestedString(document, 2),
+		Content: content,
+		Sources: sources,
+	}
+}
+
+var (
+	citeMarkerPattern = regexp.MustCompile(`\[cite:\s*([\d,\s]+)\]`)
+	citeNumberPattern = regexp.MustCompile(`\d+`)
+)
+
+// extractCitations resolves "[cite: 1, 2]" marker groups to their web sources,
+// ordered by citation number; the first occurrence of each number wins.
+func extractCitations(groups any) []SourceInfo {
+	list, ok := groups.([]interface{})
+	if !ok {
+		return nil
+	}
+	resolved := map[int]SourceInfo{}
+	for _, group := range list {
+		marker := nestedString(group, 0, 0)
+		entries, ok := nested(group, 1).([]interface{})
+		if marker == "" || !ok {
+			continue
+		}
+		scope := marker
+		if match := citeMarkerPattern.FindStringSubmatch(marker); match != nil {
+			scope = match[1]
+		}
+		numbers := citeNumberPattern.FindAllString(scope, -1)
+		for i, entry := range entries {
+			if i >= len(numbers) {
+				break
+			}
+			id, err := strconv.Atoi(numbers[i])
+			if err != nil {
+				continue
+			}
+			if _, seen := resolved[id]; seen {
+				continue
+			}
+			link := nestedString(entry, 3, 0, 1)
+			if link == "" {
+				continue
+			}
+			source := SourceInfo{Title: nestedString(entry, 3, 0, 2), URL: link}
+			if parsed, err := url.Parse(link); err == nil {
+				source.Domain = parsed.Hostname()
+			}
+			resolved[id] = source
+		}
+	}
+	ids := make([]int, 0, len(resolved))
+	for id := range resolved {
+		ids = append(ids, id)
+	}
+	sort.Ints(ids)
+	sources := make([]SourceInfo, 0, len(ids))
+	for _, id := range ids {
+		sources = append(sources, resolved[id])
+	}
+	return sources
+}
+
+func candidateTurn(candidate any) researchTurn {
+	turn := researchTurn{
+		Text:     nestedString(candidate, 1, 0),
+		Plan:     extractResearchPlan(candidate),
+		Document: extractResearchDocument(candidate),
+	}
+	if status, ok := nested(candidate, 8, 0).(float64); ok {
+		turn.Status = int(status)
+	}
+	return turn
+}
+
+// parseResearchStream reads a StreamGenerate body of a research turn. Frames
+// are cumulative, so later frames overwrite earlier ones; conversation ids are
+// merged into conv.
+func parseResearchStream(body string, conv *researchConversation) researchTurn {
+	var turn researchTurn
+	for _, payload := range decodeFrames(body, "") {
+		if ids, ok := nested(payload, 1).([]interface{}); ok {
+			conv.merge(ids)
+		}
+		if contextToken := nestedString(payload, 25); contextToken != "" {
+			conv.Metadata[9] = contextToken
+		}
+		candidates, ok := nested(payload, 4).([]interface{})
+		if !ok || len(candidates) == 0 {
+			continue
+		}
+		candidate := candidates[0]
+		if rcid := nestedString(candidate, 0); rcid != "" {
+			conv.Metadata[2] = rcid
+		}
+		current := candidateTurn(candidate)
+		if current.Text != "" {
+			turn.Text = current.Text
+		}
+		if current.Plan != nil {
+			turn.Plan = current.Plan
+		}
+		if current.Document != nil {
+			turn.Document = current.Document
+		}
+		if current.Status != 0 {
+			turn.Status = current.Status
+		}
+	}
+	return turn
+}
+
+// parseChatTurns reads a hNvQHb (list conversation turns) body, newest turn first.
+func parseChatTurns(body string) []researchTurn {
+	var turns []researchTurn
+	for _, payload := range decodeFrames(body, listConversationTurnsRPC) {
+		rawTurns, ok := nested(payload, 0).([]interface{})
+		if !ok {
+			continue
+		}
+		for _, rawTurn := range rawTurns {
+			candidates, ok := nested(rawTurn, 3, 0).([]interface{})
+			if !ok {
+				continue
+			}
+			for _, candidate := range candidates {
+				if nestedString(candidate, 0) == "" {
+					continue
+				}
+				turns = append(turns, candidateTurn(candidate))
+			}
+		}
+	}
+	return turns
+}
+
+// ---------------------------------------------------------------------------
+// Network
+// ---------------------------------------------------------------------------
+
+// readChat fetches the latest turns of a conversation, newest first.
+func (c *Client) readChat(ctx context.Context, cid string, limit int) ([]researchTurn, error) {
+	c.mu.RLock()
+	at, cookieHdr, buildLabel, sessionID := c.at, c.cookieHeader, c.buildLabel, c.sessionID
+	language, generationID, authUser := c.language, c.generationID, c.authUser
+	c.mu.RUnlock()
+	if at == "" || cookieHdr == "" {
+		return nil, errors.New("client not initialized")
+	}
+	if language == "" {
+		language = "en"
+	}
+
+	rpcPayload, _ := json.Marshal([]interface{}{cid, limit, nil, 1, []int{1}, []int{4}, nil, 1})
+	freq, _ := json.Marshal([]interface{}{[]interface{}{[]interface{}{listConversationTurnsRPC, string(rpcPayload), nil, "generic"}}})
+
+	query := url.Values{
+		"rpcids":      {listConversationTurnsRPC},
+		"hl":          {language},
+		"_reqid":      {strconv.Itoa(rand.Intn(90000) + 10000)},
+		"rt":          {"c"},
+		"source-path": {geminiSourcePath(authUser)},
+	}
+	if buildLabel != "" {
+		query.Set("bl", buildLabel)
+	}
+	if sessionID != "" {
+		query.Set("f.sid", sessionID)
+	}
+	form := url.Values{"at": {at}, "f.req": {string(freq)}}
+
+	request, err := http.NewRequestWithContext(ctx, http.MethodPost,
+		geminiAccountURL(EndpointBatchExec, authUser)+"?"+query.Encode(), strings.NewReader(form.Encode()))
+	if err != nil {
+		return nil, fmt.Errorf("create chat read request: %w", err)
+	}
+	for name, value := range DefaultHeaders {
+		request.Header.Set(name, value)
+	}
+	request.Header.Set("Cookie", cookieHdr)
+	batchHeader := make([]any, 17)
+	batchHeader[0] = 1
+	batchHeader[8] = []int{4, 5, 6, 8}
+	batchHeader[16] = generationID
+	headerJSON, _ := json.Marshal(batchHeader)
+	request.Header.Set(geminiModelHeaderKey, string(headerJSON))
+	request.Header.Set("x-goog-ext-73010989-jspb", "[0]")
+
+	response, err := (&http.Client{Timeout: 2 * time.Minute}).Do(request)
+	if err != nil {
+		// url.Error includes the session query parameters; keep only its cause.
+		var requestErr *url.Error
+		if errors.As(err, &requestErr) {
+			err = requestErr.Err
+		}
+		return nil, fmt.Errorf("chat read request failed: %w", err)
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("chat read failed with HTTP status %d", response.StatusCode)
+	}
+	body, err := io.ReadAll(io.LimitReader(response.Body, maxChatReadResponseSize))
+	if err != nil {
+		return nil, fmt.Errorf("read chat response: %w", err)
+	}
+	dumpResearchBody("chat", string(body))
+	return parseChatTurns(string(body)), nil
+}
+
+// sendResearchTurn sends one turn of a research conversation.
+func (c *Client) sendResearchTurn(ctx context.Context, prompt, model string, conv *researchConversation) (researchTurn, error) {
+	response, err := c.generateContent(ctx, prompt, conv.Metadata, WithModel(model), func(cfg *GenerateConfig) {
+		cfg.DeepResearch = true
+	})
+	if err != nil {
+		return researchTurn{}, err
+	}
+	dumpResearchBody("turn", response.RawBody)
+	turn := parseResearchStream(response.RawBody, conv)
+	if turn.Plan == nil && turn.Document == nil && turn.Text == "" && conv.cid() == "" {
+		if reason, _ := response.Metadata["parse_error"].(string); reason != "" {
+			return turn, errors.New(reason)
+		}
+	}
+	return turn, nil
+}
+
+func reportReady(turn researchTurn) bool {
+	return turn.Document != nil && strings.TrimSpace(turn.Document.Content) != ""
+}
+
+// ---------------------------------------------------------------------------
+// Public flow
+// ---------------------------------------------------------------------------
+
+// deepResearchNative runs plan → confirm → wait. progress may be nil; when it
+// returns false the wait is abandoned (the task keeps running server-side).
+func (c *Client) deepResearchNative(ctx context.Context, query string, cfg *DeepResearchConfig, progress ProgressCallback) (*DeepResearchResult, error) {
+	startTime := time.Now()
+	emit := func(event DeepResearchEvent) bool {
+		if progress == nil {
+			return true
+		}
+		return progress(event)
+	}
+
+	c.mu.RLock()
+	model := cfg.Model
+	if model == "" && len(c.cachedModels) > 0 {
+		model = c.cachedModels[0].ID
+	}
+	c.mu.RUnlock()
+
+	prompt := query
+	if language := strings.TrimSpace(cfg.Language); language != "" && !strings.EqualFold(language, "English") {
+		prompt = fmt.Sprintf("%s\n\n(Write the report in this language: %s)", query, language)
+	}
+
+	c.log.Info("Deep research (native) starting", zap.String("model", model))
+	if !emit(DeepResearchEvent{Event: EventTypeProgress, Message: "Requesting research plan...", Progress: 2}) {
+		return nil, context.Canceled
+	}
+
+	conv := newResearchConversation()
+	planTurn, err := c.sendResearchTurn(ctx, prompt, model, conv)
+	if err != nil {
+		return nil, fmt.Errorf("deep research plan request failed: %w", err)
+	}
+	if planTurn.Plan == nil {
+		preview := planTurn.Text
+		if len(preview) > 600 {
+			preview = preview[:600]
+		}
+		return nil, fmt.Errorf("Gemini did not return a deep research plan (the account may be out of Deep Research quota, or the protocol changed). Reply preview: %q", preview)
+	}
+	if conv.cid() == "" {
+		return nil, errors.New("deep research plan carries no conversation id; cannot confirm it")
+	}
+	plan := planTurn.Plan
+	steps := []StepInfo{{
+		StepNumber:  1,
+		Type:        "plan",
+		Description: strings.TrimSpace(fmt.Sprintf("Research plan: %s (%d steps) %s", plan.Title, len(plan.Steps), plan.ETA)),
+		Query:       query,
+		Result:      strings.Join(plan.Steps, " | "),
+	}}
+	c.log.Info("Deep research plan received", zap.String("cid", conv.cid()), zap.String("title", plan.Title),
+		zap.Int("steps", len(plan.Steps)), zap.String("eta", plan.ETA))
+	if !emit(DeepResearchEvent{Event: EventTypeStep, Message: steps[0].Description, Progress: 8, Step: &steps[0]}) {
+		return nil, context.Canceled
+	}
+
+	confirm := plan.ConfirmPrompt
+	if confirm == "" {
+		confirm = deepResearchDefaultConfirm
+	}
+	startTurn, err := c.sendResearchTurn(ctx, confirm, model, conv)
+	if err != nil {
+		// The confirmation can land server-side while the request itself fails;
+		// the conversation is the source of truth, so keep going and poll it.
+		c.log.Warn("Deep research confirmation request failed; polling the conversation anyway", zap.Error(err))
+	}
+	steps = append(steps, StepInfo{StepNumber: 2, Type: "search", Description: "Research started: " + confirm, Result: startTurn.Text})
+	if !emit(DeepResearchEvent{Event: EventTypeStep, Message: steps[1].Description, Progress: 12, Step: &steps[1]}) {
+		return nil, context.Canceled
+	}
+
+	final := startTurn
+	interval := deepResearchPollInterval()
+	for polls := 0; !reportReady(final); polls++ {
+		select {
+		case <-ctx.Done():
+			return nil, fmt.Errorf("deep research did not finish in time (conversation %s keeps running in Gemini; open it there to read the report): %w", conv.cid(), ctx.Err())
+		case <-time.After(interval):
+		}
+		turns, readErr := c.readChat(ctx, conv.cid(), 10)
+		if readErr != nil {
+			c.log.Warn("Deep research poll failed", zap.Error(readErr))
+			continue
+		}
+		for _, turn := range turns { // newest first; the report can sit on an earlier turn
+			if reportReady(turn) {
+				final = turn
+				break
+			}
+		}
+		elapsed := time.Since(startTime).Round(time.Second)
+		progressValue := 12 + polls*3
+		if progressValue > 90 {
+			progressValue = 90
+		}
+		if !emit(DeepResearchEvent{Event: EventTypeProgress, Message: fmt.Sprintf("Researching... %s elapsed", elapsed), Progress: progressValue}) {
+			return nil, context.Canceled
+		}
+	}
+
+	document := final.Document
+	sources := document.Sources
+	if cfg.MaxSources > 0 && len(sources) > cfg.MaxSources {
+		sources = sources[:cfg.MaxSources]
+	}
+	steps = append(steps, StepInfo{
+		StepNumber:  3,
+		Type:        "write",
+		Description: "Report received: " + document.Title,
+		Result:      fmt.Sprintf("Report: %d chars, %d sources", len(document.Content), len(document.Sources)),
+	})
+	createdAt := startTime.Unix()
+	result := &DeepResearchResult{
+		ID:          generateResearchID(query, createdAt),
+		Query:       query,
+		Summary:     document.Content,
+		Sources:     sources,
+		Steps:       steps,
+		Model:       model,
+		CreatedAt:   createdAt,
+		CompletedAt: time.Now().Unix(),
+		DurationMs:  time.Since(startTime).Milliseconds(),
+	}
+	c.log.Info("Deep research (native) completed", zap.String("cid", conv.cid()),
+		zap.Int("report_chars", len(document.Content)), zap.Int("sources", len(document.Sources)),
+		zap.Int64("duration_ms", result.DurationMs))
+	return result, nil
+}
