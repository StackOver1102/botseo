+func TestDeepResearchModeDefaultsToNative(t *testing.T) {
+	t.Setenv(deepResearchModeEnv, "")
+	if deepResearchMode() != DeepResearchModeNative {
+		t.Fatal("native must be the default mode")
+	}
+	t.Setenv(deepResearchModeEnv, " Emulated ")
+	if deepResearchMode() != DeepResearchModeEmulated {
+		t.Fatal("emulated mode must be selectable")
+	}
+	t.Setenv(deepResearchPollEnv, "2")
+	if deepResearchPollInterval() != deepResearchDefaultPoll {
+		t.Fatal("poll interval below 5s must fall back to the default")
+	}
+	t.Setenv(deepResearchPollEnv, "30")
+	if deepResearchPollInterval().Seconds() != 30 {
+		t.Fatal("poll interval override ignored")
+	}
+}
