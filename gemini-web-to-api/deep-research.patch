+package providers
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+// sparse builds a JSPB array of the given length whose trailing element is the
+// sparse bundle, keyed by one-based field number.
+func sparse(length int, fields map[int]any) []any {
+	list := make([]any, length)
+	bundle := map[string]any{}
+	for index, value := range fields {
+		bundle[itoa(index+1)] = value
+	}
+	list[length-1] = bundle
+	return list
+}
+
+func itoa(n int) string {
+	b, _ := json.Marshal(n)
+	return string(b)
+}
+
+func candidateWith(rcid, text string, rich any, document any, status int) []any {
+	candidate := make([]any, 31)
+	candidate[0] = rcid
+	candidate[1] = []any{text}
+	candidate[8] = []any{status}
+	candidate[12] = rich
+	if document != nil {
+		candidate[30] = []any{document}
+	}
+	return candidate
+}
+
+func researchDocument(taskID, title, content string, citations any) []any {
+	document := make([]any, 18)
+	document[0] = "doc-1"
+	document[2] = title
+	document[3] = taskID
+	document[4] = content
+	document[17] = []any{content, sparse(3, map[int]any{fieldCitations: citations})}
+	return document
+}
+
+// frame encodes one StreamGenerate / batchexecute envelope line.
+func frame(t *testing.T, rpcID string, payload any) string {
+	t.Helper()
+	inner, err := json.Marshal(payload)
+	if err != nil {
+		t.Fatal(err)
+	}
+	line, err := json.Marshal([]any{[]any{"wrb.fr", rpcID, string(inner)}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(line)
+}
+
+func decoded(t *testing.T, value any) any {
+	t.Helper()
+	raw, err := json.Marshal(value)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var out any
+	if err := json.Unmarshal(raw, &out); err != nil {
+		t.Fatal(err)
+	}
+	return out
+}
+
+func planPayload() []any {
+	return []any{
+		"Thời lượng trận bóng đá",
+		[]any{
+			[]any{nil, "Nghiên cứu trang web", "Tìm Luật 7 của IFAB"},
+			[]any{nil, "", "Phân tích kết quả"},
+			[]any{nil, "Tạo báo cáo", ""},
+		},
+		"Sẵn sàng sau vài phút",
+		[]any{"Bắt đầu nghiên cứu"},
+	}
+}
+
+func TestApplyDeepResearchFlags(t *testing.T) {
+	inner := buildGenerateInner("q", nil, 3, "vi", "REQ", true)
+	if inner[45] != 1 {
+		t.Fatalf("precondition: temporary flag should be set, got %v", inner[45])
+	}
+	applyDeepResearchFlags(inner)
+	token, _ := inner[3].(string)
+	if !strings.HasPrefix(token, "!") || len(token) < 2500 {
+		t.Fatalf("research token has unexpected shape (len %d)", len(token))
+	}
+	if id, _ := inner[4].(string); len(id) != 32 {
+		t.Fatalf("research request id should be 32 hex chars, got %q", inner[4])
+	}
+	if inner[45] != nil {
+		t.Fatal("deep research must not be sent as a temporary chat")
+	}
+	encoded, _ := json.Marshal([]any{inner[49], inner[54], inner[55]})
+	if string(encoded) != `[1,[[[[[1]]]]],[[1]]]` {
+		t.Fatalf("unexpected research flags: %s", encoded)
+	}
+	if inner[79] != 3 || inner[59] != "REQ" {
+		t.Fatal("research flags must not disturb the model number or request id")
+	}
+}
+
+func TestJSPBFieldReadsPositionalAndSparse(t *testing.T) {
+	positional := make([]any, 60)
+	positional[fieldResearchPlan] = []any{"positional"}
+	if got := nestedString(jspbField(decoded(t, positional), fieldResearchPlan), 0); got != "positional" {
+		t.Fatalf("positional read failed: %q", got)
+	}
+	bundle := decoded(t, sparse(9, map[int]any{fieldResearchPlan: []any{"sparse"}}))
+	if got := nestedString(jspbField(bundle, fieldResearchPlan), 0); got != "sparse" {
+		t.Fatalf("sparse read failed: %q", got)
+	}
+	if jspbField(bundle, fieldCitations) != nil {
+		t.Fatal("absent field must read as nil")
+	}
+	// The bundle sitting in the positional slot is not the field's value.
+	if jspbField(decoded(t, sparse(fieldResearchPlan+1, map[int]any{1: "x"})), fieldResearchPlan) != nil {
+		t.Fatal("the sparse bundle itself must not be returned as a field value")
+	}
+}
+
+func TestExtractResearchPlan(t *testing.T) {
+	for name, rich := range map[string]any{
+		"primary field":   sparse(9, map[int]any{fieldResearchPlan: planPayload()}),
+		"alternate field": sparse(9, map[int]any{fieldResearchPlanAlt: planPayload()}),
+	} {
+		plan := extractResearchPlan(decoded(t, candidateWith("rc_1", "Đây là kế hoạch", rich, nil, 2)))
+		if plan == nil {
+			t.Fatalf("%s: plan not found", name)
+		}
+		if plan.Title != "Thời lượng trận bóng đá" || plan.ETA != "Sẵn sàng sau vài phút" || plan.ConfirmPrompt != "Bắt đầu nghiên cứu" {
+			t.Fatalf("%s: unexpected plan %+v", name, plan)
+		}
+		want := []string{"Nghiên cứu trang web: Tìm Luật 7 của IFAB", "Phân tích kết quả", "Tạo báo cáo"}
+		if strings.Join(plan.Steps, "|") != strings.Join(want, "|") {
+			t.Fatalf("%s: steps = %v", name, plan.Steps)
+		}
+	}
+	if extractResearchPlan(decoded(t, candidateWith("rc_1", "chat thường", sparse(9, nil), nil, 2))) != nil {
+		t.Fatal("an ordinary chat turn must not yield a plan")
+	}
+}
+
+func TestExtractResearchDocumentAndCitations(t *testing.T) {
+	entry := func(link, title string) []any {
+		return []any{nil, nil, nil, []any{[]any{"favicon", link, title}}}
+	}
+	citations := []any{
+		[]any{[]any{" [cite: 2, 1]"}, []any{entry("https://b.example/two", "Hai"), entry("https://www.theifab.com/laws", "IFAB")}},
+		[]any{[]any{" [cite: 1]"}, []any{entry("https://dup.example/ignored", "trùng")}},
+		[]any{[]any{" [cite: 3]"}, []any{[]any{nil, nil, nil, []any{[]any{"f", nil, "không url"}}}}},
+	}
+	document := extractResearchDocument(decoded(t,
+		candidateWith("rc_2", "Đã xong", nil, researchDocument("task-1", "Báo cáo", "# Báo cáo\nNội dung [cite: 1]", citations), 2)))
+	if document == nil || document.Title != "Báo cáo" || !strings.HasPrefix(document.Content, "# Báo cáo") {
+		t.Fatalf("unexpected document: %+v", document)
+	}
+	if len(document.Sources) != 2 {
+		t.Fatalf("want 2 sources (first occurrence wins, url required), got %+v", document.Sources)
+	}
+	if document.Sources[0].URL != "https://www.theifab.com/laws" || document.Sources[0].Domain != "www.theifab.com" || document.Sources[0].Title != "IFAB" {
+		t.Fatalf("citation 1 resolved wrongly: %+v", document.Sources[0])
+	}
+	if document.Sources[1].URL != "https://b.example/two" {
+		t.Fatalf("citation 2 resolved wrongly: %+v", document.Sources[1])
+	}
+
+	// A non-research attachment (no task id at [3]) is not a document.
+	card := researchDocument("", "YouTube", "x", nil)
+	card[3] = nil
+	if extractResearchDocument(decoded(t, candidateWith("rc_3", "video", nil, card, 2))) != nil {
+		t.Fatal("an attachment without a task id must not be read as a research document")
+	}
+}
+
+func TestParseResearchStreamMergesConversationIDs(t *testing.T) {
+	conv := newResearchConversation()
+	early := []any{nil, []any{"c_abc", "r_1"}, nil, nil, []any{candidateWith("rc_1", "Đang lập", sparse(9, nil), nil, 1)}}
+	final := make([]any, 26)
+	final[1] = []any{"c_abc", "r_2", nil}
+	final[4] = []any{candidateWith("rc_1", "Đây là kế hoạch", sparse(9, map[int]any{fieldResearchPlan: planPayload()}), nil, 2)}
+	final[25] = "context-token"
+	body := ")]}'\n\n123\n" + frame(t, "", early) + "\n456\n" + frame(t, "", final) + "\n25\n[[\"e\",4,null,null,131]]\n"
+
+	turn := parseResearchStream(body, conv)
+	if turn.Plan == nil || turn.Text != "Đây là kế hoạch" || turn.Status != 2 {
+		t.Fatalf("unexpected turn: %+v", turn)
+	}
+	encoded, _ := json.Marshal(conv.Metadata)
+	if string(encoded) != `["c_abc","r_2","rc_1",null,null,null,null,null,null,"context-token"]` {
+		t.Fatalf("metadata = %s", encoded)
+	}
+	if conv.cid() != "c_abc" {
+		t.Fatalf("cid = %q", conv.cid())
+	}
+
+	// The confirmation turn can end without any candidate: ids must survive.
+	parseResearchStream(")]}'\n\n"+frame(t, "", []any{nil, []any{nil, "r_3"}})+"\n", conv)
+	if conv.cid() != "c_abc" || conv.Metadata[1] != "r_3" || conv.Metadata[2] != "rc_1" {
+		t.Fatalf("ids lost after an empty turn: %v", conv.Metadata)
+	}
+}
+
+func TestParseChatTurnsFindsFinishedReport(t *testing.T) {
+	running := candidateWith("rc_run", "Mình đang nghiên cứu", nil, researchDocument(deepResearchTaskPlaceholder, "", "", nil), 1)
+	running[30].([]any)[0].([]any)[17] = nil
+	finished := candidateWith("rc_done", "Đã hoàn tất", nil, researchDocument("task-9", "Báo cáo", "# Báo cáo đầy đủ", nil), 2)
+	turnOf := func(candidate any) []any {
+		return []any{[]any{"c_abc", "r_x"}, nil, nil, []any{[]any{candidate}}}
+	}
+	body := ")]}'\n\n999\n" +
+		frame(t, "otherRpc", []any{[]any{turnOf(finished)}}) + "\n" +
+		frame(t, listConversationTurnsRPC, []any{[]any{turnOf(running), turnOf(finished)}}) + "\n"
+
+	turns := parseChatTurns(body)
+	if len(turns) != 2 {
+		t.Fatalf("want 2 turns from the matching RPC only, got %d", len(turns))
+	}
+	if reportReady(turns[0]) {
+		t.Fatal("a running research turn (empty document body) must not count as ready")
+	}
+	if turns[0].Document == nil || turns[0].Status != 1 {
+		t.Fatalf("running turn should still expose its empty document: %+v", turns[0])
+	}
+	if !reportReady(turns[1]) || turns[1].Document.Content != "# Báo cáo đầy đủ" {
+		t.Fatalf("finished report not found: %+v", turns[1])
+	}
+}
